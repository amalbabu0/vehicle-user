# Supabase project (same project as the admin app). Only the anon key —
# this app never holds the service-role key. Read/write scope for this
# key is entirely governed by RLS policies keyed on auth.uid() + role.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Images — public delivery hash only, no upload token. This app
# never uploads images, only renders them via the CDN URL.
NEXT_PUBLIC_CLOUDFLARE_IMAGES_HASH=your-cloudflare-images-delivery-hash

# Upstash Redis (cache, rate limiting)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Cloudflare Turnstile (bot protection on auth forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET=

NEXT_PUBLIC_SITE_URL=https://www.example.com
