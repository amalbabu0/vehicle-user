# Supabase project (same project as the admin app). Only the anon key —
# this app never holds the service-role key. Read/write scope for this
# key is entirely governed by RLS policies keyed on auth.uid() + role.
# No NEXT_PUBLIC_ prefix — the browser gets SUPABASE_URL/SUPABASE_ANON_KEY
# at runtime via /api/public-config instead of at build time. See lib/env.ts.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Public custom domain connected to the R2 bucket (set up in the admin app).
# This app never gets R2 write credentials, only this public delivery URL.
IMAGES_CDN_URL=https://cdn.example.com

# Upstash Redis (cache, rate limiting)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Cloudflare Turnstile (bot protection on auth forms)
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

SITE_URL=https://www.example.com

# Shared secret with the admin app for POST /api/revalidate (instant cache
# refresh on publish/status change). Generate with `openssl rand -hex 32`;
# must match the admin app's REVALIDATE_SECRET exactly.
REVALIDATE_SECRET=your-shared-revalidate-secret
